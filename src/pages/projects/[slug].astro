---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
export async function getStaticPaths() { const projects = await getCollection('projects', ({ data }) => data.locale === 'zh'); return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } })); }
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { Content } = await render(project);
---
<ProjectLayout project={project} locale="zh"><Content /></ProjectLayout>
