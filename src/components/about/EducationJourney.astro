---
import type { AboutContent } from '../../data/about';

interface Props {
  content: AboutContent;
  eyebrow: string;
  title: string;
  intro: string;
}

const { content, eyebrow, title, intro } = Astro.props;
---

<section class="section" data-about-section="education" aria-labelledby="education-journey-title">
  <div class="container about-split">
    <div class="section-heading">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="education-journey-title">{title}</h2>
      <p>{intro}</p>
    </div>
    <ol class="education-journey">
      {content.schools.map((school, index) => (
        <li data-school-id={school.id}>
          <span class="journey-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <article>
            {school.period && <time class="journey-date">{school.period}</time>}
            <h3>{school.name}</h3>
            <p>{content.schoolNotes[school.id]}</p>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>
