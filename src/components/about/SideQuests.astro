---
import type { AboutContent } from '../../data/about';

interface Props {
  content: AboutContent;
  eyebrow: string;
  title: string;
  interestsLabel: string;
  gamesLabel: string;
}

const { content, eyebrow, title, interestsLabel, gamesLabel } = Astro.props;
---

<section class="section section-surface side-quests" data-about-section="side-quests" aria-labelledby="side-quests-title">
  <div class="container">
    <div class="section-heading side-quests-heading">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="side-quests-title">{title}</h2>
      <p>{content.sideQuests.intro}</p>
    </div>
    <div class="side-quest-grid">
      {content.sideQuests.explorations.map((quest) => (
        <article>
          <p class="journey-state">{quest.state}</p>
          <h3>{quest.title}</h3>
          <p>{quest.description}</p>
        </article>
      ))}
    </div>
    <div class="side-quest-life">
      <div>
        <h3>{interestsLabel}</h3>
        <ul class="interest-chips">{content.sideQuests.interests.map((interest) => <li>{interest}</li>)}</ul>
      </div>
      <div>
        <h3>{gamesLabel}</h3>
        <ul class="interest-chips">{content.sideQuests.games.map((game) => <li>{game}</li>)}</ul>
      </div>
    </div>
  </div>
</section>
