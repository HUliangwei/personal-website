---
import { journeyByLocale } from '../../data/journey';
import type { Locale } from '../../i18n/types';
import JourneyStageVisual from './JourneyStageVisual.astro';

interface Props {
  locale: Locale;
  content: {
    eyebrow: string;
    title: string;
    intro: string;
    statusLabel: string;
  };
}

const { locale, content } = Astro.props;
const stages = journeyByLocale[locale];
---

<section class="section journey-section section-surface" aria-labelledby="journey-title" data-about-journey>
  <div class="container journey-layout">
    <div class="journey-sticky">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2 id="journey-title">{content.title}</h2>
      <p>{content.intro}</p>
      <div class="journey-progress" aria-hidden="true"><i data-journey-progress></i></div>
      <p class="journey-status" data-journey-status>{content.statusLabel}</p>
    </div>
    <ol class="journey-timeline">
      {stages.map((stage, index) => (
        <li class:list={['journey-stage', { 'journey-stage-todo': stage.evidence === 'TODO' }]} data-journey-stage data-stage-id={stage.id}>
          <span class="journey-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <article class="journey-stage-card">
            <div class="journey-stage-copy">
              <p class="journey-date">{stage.date}</p>
              <h3>{stage.title}</h3>
              {stage.state && <p class="journey-state">{stage.state}</p>}
              <p class="journey-summary">{stage.summary}</p>
              <p>{stage.detail}</p>
            </div>
            <JourneyStageVisual id={stage.id} locale={locale} motif={stage.motif} title={stage.title} />
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import { createJourneyMotionController } from '../../scripts/journey-motion';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const desktopJourney = window.matchMedia('(min-width: 48.001rem)');
  const roots = document.querySelectorAll<HTMLElement>('[data-about-journey]');
  let controllers: Array<{ dispose(): void }> = [];

  const mount = () => {
    if (controllers.length) return;
    controllers = Array.from(roots, (root) => createJourneyMotionController({
      desktop: desktopJourney,
      reduced: reduceMotion,
      initialize: async () => {
        const abortController = new AbortController();
        const { initAboutJourney } = await import('../../scripts/about-journey');
        const disposeJourney = initAboutJourney(root, { signal: abortController.signal });
        return () => {
          abortController.abort();
          disposeJourney();
        };
      },
    }));
  };

  const teardown = () => {
    controllers.forEach((controller) => controller.dispose());
    controllers = [];
  };
  const handlePageShow = (event: PageTransitionEvent) => { if (event.persisted) mount(); };

  mount();
  window.addEventListener('pagehide', teardown);
  window.addEventListener('pageshow', handlePageShow);
</script>
