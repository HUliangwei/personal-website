---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { aboutByLocale } from '../../data/about';
import { getDictionary } from '../../i18n/utils';
import type { Locale } from '../../i18n/types';
import DualTrackJourney from '../about/DualTrackJourney.astro';
import EducationJourney from '../about/EducationJourney.astro';
import HowIWork from '../about/HowIWork.astro';
import Now from '../about/Now.astro';
import SideQuests from '../about/SideQuests.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const d = getDictionary(locale);
const labels = d.about;
const content = aboutByLocale[locale];
---

<BaseLayout locale={locale} title={d.meta.about.title} description={d.meta.about.description}>
  <section class="about-hero section" data-about-section="about-me" aria-labelledby="about-title">
    <div class="container about-hero-grid">
      <div>
        <p class="eyebrow">{content.intro.eyebrow}</p>
        <h1 id="about-title">{content.intro.title}</h1>
        <p class="about-hero-summary">{content.intro.summary}</p>
      </div>
      <div class="about-hero-visual" role="img" aria-label={content.intro.visualLabel}>
        {content.intro.visualSteps.map((step, index) => (
          <>{index > 0 && <i aria-hidden="true"></i>}<span>{step}</span></>
        ))}
      </div>
    </div>
  </section>
  <EducationJourney content={content} {...labels.education} />
  <DualTrackJourney content={content} locale={locale} {...labels.technicalJourney} />
  <HowIWork content={content} {...labels.howIWork} />
  <Now content={content} {...labels.now} />
  <SideQuests
    content={content}
    eyebrow={labels.sideQuests.eyebrow}
    title={labels.sideQuests.title}
  />
</BaseLayout>
