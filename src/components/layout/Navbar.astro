---
import { SITE } from '../../config/site';
import { alternatePath, getDictionary, localizedPath, stripLocalePrefix } from '../../i18n/utils';
import type { Locale } from '../../i18n/types';

interface Props { locale?: Locale; }
const { locale = 'zh' } = Astro.props;
const dictionary = getDictionary(locale);

const currentPath = stripLocalePrefix(Astro.url.pathname);
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(`${href}/`));
---

<header class="site-header">
  <div class="container nav-shell">
    <a class="brand" href={localizedPath('/', locale)} aria-label={SITE.name}>
      {SITE.name}
    </a>

    <button class="nav-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false" aria-label={dictionary.navigation.open} data-open-label={dictionary.navigation.open} data-close-label={dictionary.navigation.close}>
      <span class="sr-only">{dictionary.navigation.toggle}</span>
      <span aria-hidden="true" class="nav-toggle-icon"></span>
    </button>

    <nav id="primary-navigation" class="primary-nav" aria-label={dictionary.navigation.label}>
      <ul>
        {
          dictionary.navigation.items.map((item) => (
            <li>
              <a href={localizedPath(item.path, locale)} aria-current={isActive(item.path) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={alternatePath(Astro.url.pathname)} data-language-switch>{dictionary.navigation.languageSwitch}</a>
        </li>
        <li>
          <a href={SITE.github} rel="external">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  document.documentElement.classList.add('js-enabled');

  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const navigation = document.querySelector<HTMLElement>('#primary-navigation');

  const closeNavigation = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', toggle.dataset.openLabel ?? '');
    navigation?.removeAttribute('data-open');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? (toggle.dataset.openLabel ?? '') : (toggle.dataset.closeLabel ?? ''));
    navigation?.toggleAttribute('data-open', !isOpen);
  });

  navigation?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) closeNavigation();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closeNavigation();
      toggle.focus();
    }
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    if (!toggle?.contains(target) && !navigation?.contains(target)) closeNavigation();
  });

  window.matchMedia('(min-width: 44.0625rem)').addEventListener('change', closeNavigation);
</script>
