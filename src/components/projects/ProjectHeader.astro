---
import type { CollectionEntry } from 'astro:content';
import ProjectMeta from './ProjectMeta.astro';
import type { Dictionary, Locale } from '../../i18n/types';
import ProjectVisual from './ProjectVisual.astro';
interface Props { project: CollectionEntry<'projects'>; dictionary: Dictionary; locale: Locale; }
const { project, dictionary, locale } = Astro.props;
const content = dictionary.projects;
const entry = content.entries[project.data.slug as keyof typeof content.entries];
const title = entry?.title ?? project.data.title;
const summary = entry?.summary ?? project.data.summary;
---
<header class="project-header">
  <p class="eyebrow">{content.categories[project.data.category]}</p>
  <h1>{title}</h1>
  <p class="project-summary">{summary}</p>
  <ProjectMeta project={project} dictionary={dictionary} />
  {
    project.data.cover ? (
      <img class="project-detail-cover" src={project.data.cover} alt={`${title} ${content.coverAltSuffix}`} loading="lazy" />
    ) : (
      <ProjectVisual slug={project.data.slug} locale={locale} />
    )
  }
</header>
