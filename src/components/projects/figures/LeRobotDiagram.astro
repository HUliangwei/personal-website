---
import type { Locale } from '../../../i18n/types';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const titleId = `lerobot-title-${locale}`;
const descId = `lerobot-desc-${locale}`;
const title = locale === 'zh' ? 'LeRobot 学习流程概念图' : 'Conceptual LeRobot learning workflow';
const description = locale === 'zh' ? '仅表示待核实的 LeRobot 数据、ACT、checkpoint、推理及 MuJoCo 或机器人动作流程，不代表已完成。' : 'A pending conceptual flow across LeRobot data, ACT, checkpoints, inference, and MuJoCo or robot action; it does not claim completion.';
---
<svg class="project-visual-svg" role="img" aria-labelledby={`${titleId} ${descId}`} viewBox="0 0 960 360" xmlns="http://www.w3.org/2000/svg">
  <title id={titleId}>{title}</title><desc id={descId}>{description}</desc>
  <path class="diagram-rail diagram-rail-dashed" d="M112 134H850" aria-hidden="true"/>
  <g class="diagram-nodes diagram-nodes-pending">
    <g transform="translate(28 94)"><rect width="160" height="80" rx="14"/><text x="80" y="36">LeRobot Dataset</text><text x="80" y="57">/ PushT</text></g>
    <g transform="translate(218 94)"><rect width="150" height="80" rx="14"/><text x="75" y="36">ACT</text><text x="75" y="57">Transformer</text></g>
    <g transform="translate(398 94)"><rect width="135" height="80" rx="14"/><text x="67.5" y="48">Checkpoint</text></g>
    <g transform="translate(563 94)"><rect width="130" height="80" rx="14"/><text x="65" y="48">Inference</text></g>
    <g transform="translate(723 94)"><rect width="205" height="80" rx="14"/><text x="102.5" y="36">MuJoCo /</text><text x="102.5" y="57">Robot Action</text></g>
  </g>
  <text class="diagram-disclosure" x="480" y="260">{locale === 'zh' ? '概念学习流程 · 非已完成结果声明' : 'Conceptual learning pipeline · not a completed-result claim'}</text>
</svg>
