---
import type { ProjectCategory } from '../../config/projects';
import type { Dictionary } from '../../i18n/types';
interface Props { categories: ProjectCategory[]; dictionary: Dictionary; }
const { categories, dictionary } = Astro.props;
const filters = [{ value: 'All', label: dictionary.projects.allCategory }, ...categories.map((value) => ({ value, label: dictionary.projects.categories[value] }))];
---
<fieldset class="project-filter" data-project-filter>
  <legend class="sr-only">{dictionary.projects.filterLabel}</legend>
  <div class="project-filter-controls" role="toolbar" aria-label={dictionary.projects.filterLabel}>
    {filters.map((category, index) => (
      <button type="button" data-category={category.value} aria-pressed={index === 0 ? 'true' : 'false'}>{category.label}</button>
    ))}
  </div>
  <p class="project-filter-empty" data-project-filter-empty hidden aria-live="polite">{dictionary.projects.emptyState}</p>
</fieldset>
<script>
  const filter = document.querySelector<HTMLElement>('[data-project-filter]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-project-card]')];
  const emptyState = filter?.querySelector<HTMLElement>('[data-project-filter-empty]');
  const buttons = [...(filter?.querySelectorAll<HTMLButtonElement>('button[data-category]') ?? [])];
  const selectCategory = (button: HTMLButtonElement) => {
    const category = button.dataset.category;
    buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    let visibleCount = 0;
    cards.forEach((card) => {
      card.hidden = category !== 'All' && card.dataset.category !== category;
      if (!card.hidden) visibleCount += 1;
    });
    if (emptyState) emptyState.hidden = visibleCount !== 0;
  };
  filter?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-category]');
    if (!button) return;
    selectCategory(button);
  });
  filter?.addEventListener('keydown', (event) => {
    if (!(event.target instanceof HTMLButtonElement) || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault();
    const current = buttons.indexOf(event.target);
    const next = event.key === 'Home' ? 0 : event.key === 'End' ? buttons.length - 1 : (current + (event.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length;
    buttons[next]?.focus();
    if (buttons[next]) selectCategory(buttons[next]);
  });
</script>
