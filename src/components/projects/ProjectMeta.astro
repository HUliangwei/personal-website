---
import type { CollectionEntry } from 'astro:content';
import type { Dictionary } from '../../i18n/types';
interface Props { project: CollectionEntry<'projects'>; dictionary: Dictionary; }
const { project, dictionary } = Astro.props;
const labels = dictionary.projects.detail;
---
<dl class="project-meta">
  <div><dt>{labels.date}</dt><dd>{project.data.date}</dd></div>
  <div><dt>{labels.status}</dt><dd>{project.data.status}</dd></div>
  <div><dt>{labels.role}</dt><dd>{project.data.role}</dd></div>
  <div><dt>{labels.technologies}</dt><dd>{project.data.technologies.join(' · ')}</dd></div>
</dl>
