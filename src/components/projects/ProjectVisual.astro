---
import type { Locale } from '../../i18n/types';
import type { ProjectSlug } from '../../config/projects';
import ProjectFigure from './ProjectFigure.astro';
import SpadDiagram from './figures/SpadDiagram.astro';
import LeRobotDiagram from './figures/LeRobotDiagram.astro';
import MobileRobotDiagram from './figures/MobileRobotDiagram.astro';
import QuantumHfssDiagram from './figures/QuantumHfssDiagram.astro';

interface Props { slug: ProjectSlug; locale: Locale; compact?: boolean; }
const { slug, locale, compact = false } = Astro.props;
const diagrams = { spad: SpadDiagram, lerobot: LeRobotDiagram, 'mobile-robot': MobileRobotDiagram, 'quantum-hfss': QuantumHfssDiagram };
const Diagram = diagrams[slug];
const compactSteps = {
  spad: ['SPAD', 'AFE', 'Control', 'FPGA'],
  lerobot: ['Learned', 'Practicing', 'Planned', 'Next'],
  'mobile-robot': ['Camera', 'YOLO', 'ROS', 'Robot'],
  'quantum-hfss': ['Geometry', 'HFSS', 'Sweep', 'Optimize'],
} as const;
const labels = {
  zh: {
    caption: '项目概念示意图',
    alt: { spad: 'SPAD 芯片设计功能链路概念图', lerobot: '具身智能学习状态地图概念图', 'mobile-robot': '智能小车感知至执行链路概念图', 'quantum-hfss': '超导量子计算相关结构 HFSS 仿真方法概念图' },
  },
  en: {
    caption: 'Conceptual project diagram',
    alt: { spad: 'Conceptual SPAD IC design functional chain', lerobot: 'Conceptual embodied AI learning status map', 'mobile-robot': 'Conceptual mobile robot perception-to-action chain', 'quantum-hfss': 'Conceptual HFSS simulation method for superconducting quantum computing structures' },
  },
} as const;
---
<div class="project-visual" data-project-visual={slug}>
  <ProjectFigure type="conceptual" locale={locale} caption={labels[locale].caption} alt={labels[locale].alt[slug]} compact={compact}>
    {compact ? (
      <ol class="project-visual-flow" aria-hidden="true">
        {compactSteps[slug].map((step) => <li>{step}</li>)}
      </ol>
    ) : (
      <Diagram locale={locale} />
    )}
  </ProjectFigure>
</div>
