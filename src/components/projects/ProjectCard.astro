---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; headingLevel?: 2 | 3; }
const { project, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---
<article class="project-card" data-project-card data-category={project.data.category}>
  {
    project.data.cover !== 'TODO' ? (
      <img class="project-card-cover" src={project.data.cover} alt={`${project.data.title} cover`} loading="lazy" />
    ) : (
      <div class="project-cover-todo" role="img" aria-label={`${project.data.title} cover placeholder`}>
        TODO: Add project cover image
      </div>
    )
  }
  <p class="project-category">{project.data.category}</p>
  <Heading>{project.data.title}</Heading>
  <p>{project.data.summary}</p>
  <ul class="technology-list" aria-label="Technologies">
    {project.data.technologies.map((technology) => <li>{technology}</li>)}
  </ul>
  <a href={`/projects/${project.data.slug}`}>View project <span aria-hidden="true">→</span></a>
</article>
