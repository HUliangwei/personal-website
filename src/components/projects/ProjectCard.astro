---
import type { CollectionEntry } from 'astro:content';
import type { Dictionary, Locale } from '../../i18n/types';
import ProjectVisual from './ProjectVisual.astro';
interface Props { project: CollectionEntry<'projects'>; dictionary: Dictionary; locale: Locale; headingLevel?: 2 | 3; }
const { project, dictionary, locale, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const content = dictionary.projects;
const category = content.categories[project.data.category];
---
<article class="project-card" data-project-card data-project-slug={project.data.slug} data-category={project.data.category} data-project-state={project.data.status}>
  {
    project.data.cover ? (
      <div class="project-card-media"><img class="project-card-cover" src={project.data.cover} alt={`${project.data.title} ${content.coverAltSuffix}`} loading="lazy" /></div>
    ) : (
      <ProjectVisual slug={project.data.slug} locale={locale} compact />
    )
  }
  <div class="project-card-meta-line">
    <p class="project-category" data-project-field="category">{category}</p>
    <p class="project-date"><span class="sr-only">{content.date}: </span><span data-project-field="date">{project.data.date}</span></p>
  </div>
  <Heading data-project-field="title">{project.data.title}</Heading>
  <p class="project-status"><span class="project-status-label">{content.status}: </span><span data-project-field="status">{project.data.status}</span></p>
  <p class="project-summary">{project.data.summary}</p>
  <ul class="project-highlights" aria-label={content.highlights}>
    {project.data.highlights.map((highlight) => <li>{highlight}</li>)}
  </ul>
  {project.data.technologies.length ? (
    <section class="project-topic-group" aria-label={content.completedTools}>
      <p class="project-topic-label">{content.completedTools}</p>
      <ul class="technology-list">{project.data.technologies.map((technology) => <li>{technology}</li>)}</ul>
    </section>
  ) : null}
  {project.data.learningTopics.length ? (
    <section class="project-topic-group" aria-label={content.learningTopics}>
      <p class="project-topic-label">{content.learningTopics}</p>
      <ul class="learning-topic-list">{project.data.learningTopics.map((topic) => <li>{topic}</li>)}</ul>
    </section>
  ) : null}
</article>
