---

<section class="section section-surface" aria-labelledby="capabilities-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">03 / Practice</p>
      <h2 id="capabilities-title">Capabilities</h2>
      <p>A working map of technical areas; supporting details will be added from verified experience.</p>
    </div>
    <div class="capability-grid">
      {capabilities.map(([title, detail]) => (
        <article>
          <h3>{title}</h3>
          <p>{detail}</p>
        </article>
      ))}
    </div>
  </div>
</section>
