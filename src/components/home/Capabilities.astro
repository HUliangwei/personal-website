---
import type { Dictionary } from '../../i18n/types';
interface Props { content: Dictionary['home']['capabilities']; }
const { content } = Astro.props;
---

<section class="section section-surface" aria-labelledby="capabilities-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2 id="capabilities-title">{content.title}</h2>
      <p>{content.description}</p>
    </div>
    <div class="capability-grid">
      {content.items.map(([title, detail]) => (
        <article>
          <h3>{title}</h3>
          <p>{detail}</p>
        </article>
      ))}
    </div>
  </div>
</section>
