---
import { getCollection } from 'astro:content';
import ProjectCard from '../projects/ProjectCard.astro';
const projects = (await getCollection('projects')).filter((project) => project.data.featured);
---
<section class="section" aria-labelledby="projects-title"><div class="container">
  <div class="section-heading section-heading-row"><div>
    <p class="eyebrow">02 / Work</p><h2 id="projects-title">Selected projects</h2>
  </div><a class="text-link" href="/projects">All projects <span aria-hidden="true">→</span></a></div>
  <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
</div></section>
