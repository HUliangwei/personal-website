---
const projects = [
  { title: 'SPAD Readout ASIC', category: 'Integrated Circuits', href: '/projects/spad', mark: 'IC' },
  { title: 'ROS2 Mobile Robot', category: 'Robotics', href: '/projects/ros2-robot', mark: 'R2' },
  { title: 'LeRobot / ACT', category: 'Embodied AI', href: '/projects/lerobot', mark: 'AI' },
];
---

<section class="section" aria-labelledby="projects-title">
  <div class="container">
    <div class="section-heading section-heading-row">
      <div>
        <p class="eyebrow">02 / Work</p>
        <h2 id="projects-title">Selected projects</h2>
      </div>
      <a class="text-link" href="/projects">All projects <span aria-hidden="true">→</span></a>
    </div>
    <div class="project-grid">
      {projects.map((project) => (
        <article class="project-card">
          <div class="project-mark" aria-hidden="true">{project.mark}</div>
          <p class="project-category">{project.category}</p>
          <h3>{project.title}</h3>
          <p>TODO: Add a verified project summary.</p>
          <a href={project.href}>View project <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>
