---
import type { Dictionary } from '../../i18n/types';
interface Props { content: Dictionary['home']['timeline']; }
const { content } = Astro.props;
---

<section class="section" aria-labelledby="trajectory-title">
  <div class="container timeline-layout">
    <div class="section-heading">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2 id="trajectory-title">{content.title}</h2>
    </div>
    <ol class="timeline">
      {content.stages.map(([title, detail]) => (
        <li>
          <h3>{title}</h3>
          <p>{detail}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
