---
import type { Dictionary } from '../../i18n/types';
interface Props { content: Dictionary['home']['focus']; }
const { content } = Astro.props;
---

<section class="section section-bordered" aria-labelledby="focus-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2 id="focus-title">{content.title}</h2>
      <p>{content.description}</p>
    </div>
    <ol class="focus-list">
      {content.areas.map((area, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{area}</li>)}
    </ol>
  </div>
</section>
