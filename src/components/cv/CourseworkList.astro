---
import type { CourseworkRecord, EducationRecord } from '../../data/education';

interface Props {
  educationId: EducationRecord['id'];
  coursework: CourseworkRecord[];
  gradeLabel: string;
}

const { educationId, coursework, gradeLabel } = Astro.props;
const displayGrade = (grade: string) => (grade.includes('/') ? grade : `${grade} / 100`);
---

<ul class="coursework-list" data-coursework-list>
  {
    coursework.map((course) => {
      const gradeId = `course-grade-${educationId}-${course.id}`;
      return (
        <li
          class="coursework-item"
          data-course-id={course.id}
          data-grade={course.grade}
          tabindex="0"
          aria-describedby={gradeId}
        >
          <span class="coursework-label">{course.label}</span>
          <span id={gradeId} class="coursework-grade" data-course-grade>
            <span class="sr-only">{gradeLabel}: </span>{displayGrade(course.grade)}
          </span>
        </li>
      );
    })
  }
</ul>
