---
import type { AcademicProfileCopy } from '../../data/cv';
import type { EducationRecord } from '../../data/education';
import CourseworkList from './CourseworkList.astro';

interface Props {
  education: EducationRecord;
  copy: AcademicProfileCopy;
}

const { education, copy } = Astro.props;
---

<article class="education-card" data-education-card data-education-id={education.id}>
  <header class="education-card-header">
    <div>
      <p class="education-period">{education.period}</p>
      <h3>{education.institution}</h3>
      <p class="education-program">{education.program}</p>
    </div>
    <p class="education-source">{copy.periodSource}</p>
  </header>

  <dl class="education-facts">
    <div>
      <dt>{copy.gpa}</dt>
      <dd>{education.gpa.value} / {education.gpa.scale}</dd>
      <dd class="education-evidence">{copy.officialSource}</dd>
      <dd class="education-context">{education.gpa.context}</dd>
    </div>
    {
      education.rank && (
        <div>
          <dt>{copy.rank}</dt>
          <dd>{education.rank.value}</dd>
          <dd class="education-evidence">{education.rank.context}</dd>
        </div>
      )
    }
    {
      education.researchFocus && (
        <div>
          <dt>{copy.researchFocus}</dt>
          <dd>{education.researchFocus.label}</dd>
          <dd class="education-evidence">{copy.resumeSource}</dd>
        </div>
      )
    }
  </dl>

  <div class="education-coursework">
    <h4>{copy.selectedCoursework}</h4>
    {copy.editorialTranslationNote && <p class="education-translation-note">{copy.editorialTranslationNote}</p>}
    <CourseworkList educationId={education.id} coursework={education.coursework} gradeLabel={copy.gradeLabel} />
  </div>
</article>
