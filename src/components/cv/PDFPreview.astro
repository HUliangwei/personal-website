---
interface Props {
  id: string;
  title: string;
  pdf: string;
  labels: { preview: string; hidePreview: string; fallbackPrefix: string; fallbackLink: string };
}

const { id, title, pdf, labels } = Astro.props;
const previewId = `pdf-preview-${id}`;
---

<div class="pdf-preview">
  <button class="button button-secondary" type="button" data-pdf-preview data-pdf-url={pdf} data-pdf-title={title} data-preview-label={labels.preview} data-hide-label={labels.hidePreview} data-fallback-prefix={labels.fallbackPrefix} data-fallback-link={labels.fallbackLink} aria-controls={previewId} aria-expanded="false" hidden>
    {labels.preview}
  </button>
  <div id={previewId} class="pdf-preview-frame" data-pdf-preview-frame hidden aria-live="polite"></div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-pdf-preview]').forEach((button) => {
    button.hidden = false;
    button.addEventListener('click', () => {
      const frame = document.getElementById(button.getAttribute('aria-controls') ?? '');
      const pdf = button.dataset.pdfUrl;
      const title = button.dataset.pdfTitle;

      if (!frame || !pdf || !title) return;

      if (button.getAttribute('aria-expanded') === 'false') {
        const preview = document.createElement('object');
        preview.data = pdf;
        preview.type = 'application/pdf';
        preview.setAttribute('aria-label', `${title} PDF preview`);
        const fallbackPrefix = button.dataset.fallbackPrefix ?? '';
        const fallbackLink = button.dataset.fallbackLink ?? '';
        preview.innerHTML = `${fallbackPrefix} <a href="${pdf}" target="_blank" rel="noopener">${fallbackLink}</a>`;
        frame.replaceChildren(preview);
        frame.hidden = false;
        button.setAttribute('aria-expanded', 'true');
        button.textContent = button.dataset.hideLabel ?? '';
        return;
      }

      frame.hidden = true;
      button.setAttribute('aria-expanded', 'false');
      button.textContent = button.dataset.previewLabel ?? '';
    });
  });
</script>
