---
interface Props {
  title: string;
  pdf: string;
}

const { title, pdf } = Astro.props;
const previewId = `pdf-preview-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<div class="pdf-preview">
  <button class="button button-secondary" type="button" data-pdf-preview data-pdf-url={pdf} data-pdf-title={title} aria-controls={previewId} aria-expanded="false" hidden>
    Preview PDF
  </button>
  <div id={previewId} class="pdf-preview-frame" data-pdf-preview-frame hidden aria-live="polite"></div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-pdf-preview]').forEach((button) => {
    button.hidden = false;
    button.addEventListener('click', () => {
      const frame = document.getElementById(button.getAttribute('aria-controls') ?? '');
      const pdf = button.dataset.pdfUrl;
      const title = button.dataset.pdfTitle;

      if (!frame || !pdf || !title) return;

      if (button.getAttribute('aria-expanded') === 'false') {
        const preview = document.createElement('object');
        preview.data = pdf;
        preview.type = 'application/pdf';
        preview.setAttribute('aria-label', `${title} PDF preview`);
        preview.innerHTML = `Your browser cannot display this PDF inline. <a href="${pdf}" target="_blank" rel="noopener">Open ${title} PDF</a> instead.`;
        frame.replaceChildren(preview);
        frame.hidden = false;
        button.setAttribute('aria-expanded', 'true');
        button.textContent = 'Hide preview';
        return;
      }

      frame.hidden = true;
      button.setAttribute('aria-expanded', 'false');
      button.textContent = 'Preview PDF';
    });
  });
</script>
