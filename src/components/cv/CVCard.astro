---
import PDFPreview from './PDFPreview.astro';
import type { Dictionary } from '../../i18n/types';

interface Props {
  id: string;
  title: string;
  description: string;
  pdf?: string;
  available?: boolean;
  labels: Dictionary['cv']['actions'];
}

const { id, title, description, pdf, available = false, labels } = Astro.props;
---

<article class:list={['cv-card', { 'cv-card-unavailable': !available }]} data-cv-track={id}>
  <div class="cv-card-copy">
    <h2>{title}</h2>
    <p>{description}</p>
  </div>

  {
    available && pdf ? (
      <>
        <PDFPreview id={id} title={title} pdf={pdf} labels={labels} />
        <div class="cv-actions" aria-label={`${title} ${labels.groupSuffix}`}>
          <a class="button button-secondary" href={pdf} target="_blank" rel="noopener">{labels.open}</a>
          <a class="button button-primary" href={pdf} download>{labels.download}</a>
        </div>
      </>
    ) : (
      <p class="cv-coming-soon" role="status">{labels.comingSoon}</p>
    )
  }
</article>
