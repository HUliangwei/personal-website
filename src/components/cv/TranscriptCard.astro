---
import type { TranscriptRecord } from '../../data/transcripts';

interface Props {
  transcript: TranscriptRecord;
}

const { transcript } = Astro.props;
---

<article class="transcript-card" data-transcript-id={transcript.id}>
  <h3>{transcript.title}</h3>
  <p role="status">{transcript.statusLabel}</p>
</article>
