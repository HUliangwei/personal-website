---
import type { CollectionEntry } from 'astro:content';
import ProjectHeader from '../components/projects/ProjectHeader.astro';
import BaseLayout from './BaseLayout.astro';
import { getDictionary, localizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/types';
interface Props { project: CollectionEntry<'projects'>; locale: Locale; }
const { project, locale } = Astro.props;
const dictionary = getDictionary(locale);
const entry = dictionary.projects.entries[project.data.slug as keyof typeof dictionary.projects.entries];
const title = entry?.title ?? project.data.title;
const description = `${title}: ${entry?.summary ?? dictionary.projects.detail.descriptionPending} ${dictionary.projects.detail.descriptionSuffix}`;
const detail = dictionary.projects.detail;
---
<BaseLayout locale={locale} title={`${title} | ${dictionary.siteName}`} description={description} openGraph={{ type: 'article' }}>
  <article class="section project-detail"><div class="container project-detail-container">
    <a class="text-link project-back" href={localizedPath('/projects', locale)}>← {detail.back}</a>
    <ProjectHeader project={project} dictionary={dictionary} />
    <div class="project-prose"><slot /></div>
    <section class="project-links" aria-labelledby="project-links-heading"><h2 id="project-links-heading">{detail.links}</h2>{project.data.links.length > 0 ? <ul>{project.data.links.map((link) => <li><a href={link.url}>{link.label}</a></li>)}</ul> : <p>{detail.linksPending}</p>}</section>
  </div></article>
</BaseLayout>
