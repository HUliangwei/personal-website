---
import type { CollectionEntry } from 'astro:content';
import ProjectHeader from '../components/projects/ProjectHeader.astro';
import BaseLayout from './BaseLayout.astro';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const description = project.data.summary === 'TODO'
  ? `${project.data.title}, a project case study in ${project.data.category} with details marked for verification.`
  : project.data.summary;
---
<BaseLayout title={`${project.data.title} | Liangwei Hu`} description={description} openGraph={{ type: 'article' }}>
  <article class="section project-detail"><div class="container project-detail-container">
    <a class="text-link project-back" href="/projects">← All projects</a>
    <ProjectHeader project={project} />
    <div class="project-prose"><slot /></div>
    <section class="project-links" aria-labelledby="project-links-heading">
      <h2 id="project-links-heading">Links</h2>
      {project.data.links.length > 0 ? (
        <ul>{project.data.links.map((link) => <li><a href={link.url}>{link.label}</a></li>)}</ul>
      ) : (
        <p>TODO: Add verified project links.</p>
      )}
    </section>
  </div></article>
</BaseLayout>
